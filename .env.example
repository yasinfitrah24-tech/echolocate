QLOO_API_KEY=
# Pitch emails: OpenRouter key under either name (LLM_API_KEY or OPENROUTER_API_KEY)
# and any OpenRouter model id, e.g. google/gemma-4-31b-it:free for testing
LLM_API_KEY=
LLM_MODEL=
# Or DeepSeek's own API, used when no OpenRouter key is set
DEEPSEEK_API_KEY=
# Optional: DeepSeek model (default deepseek-flash)
DEEPSEEK_MODEL=
# Optional: "off" pauses live Qloo searches; the saved example keeps working
QLOO_LIVE=
