QLOO_API_KEY=
# Pitch emails: OpenRouter (any model id, e.g. a ":free" one for testing)
OPENROUTER_API_KEY=
LLM_MODEL=
# Or DeepSeek's own API, used when OPENROUTER_API_KEY is empty
DEEPSEEK_API_KEY=
# Optional: DeepSeek model (default deepseek-flash)
DEEPSEEK_MODEL=
# Optional: "off" pauses live Qloo searches; the saved example keeps working
QLOO_LIVE=
